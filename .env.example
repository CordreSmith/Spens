# Copy this file to .env.local and fill in the values from Google Cloud Console.
# These values are public by design (they ship inside the web app), but keep them
# restricted to your own domains in Google Cloud Console. See SETUP.md.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
# The Google Cloud project NUMBER (not the project ID). Needed by Google Picker.
VITE_GOOGLE_APP_ID=
